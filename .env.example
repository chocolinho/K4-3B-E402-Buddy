# Sao chép file này thành .env rồi điền key của provider bạn chọn. Không commit .env.
AI_PROVIDER=openrouter

# OpenRouter miễn phí, dùng model cố định để kết quả eval có thể so sánh.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=qwen/qwen3.8-27b:free

# Cấu hình Gemini dự phòng nếu đổi AI_PROVIDER=gemini.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Kết quả resolved/unresolved thấp hơn ngưỡng này sẽ chuyển thành uncertain.
BUDDY_CONFIDENCE_THRESHOLD=0.65

# Free tier của một số model chỉ cho khoảng 5 request/phút.
BUDDY_EVAL_DELAY_SECONDS=13
BUDDY_EVAL_RETRIES=2
