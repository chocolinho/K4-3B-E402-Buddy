        <!-- STEP 6: Final Outcome -->
        <mxCell id="step6" value="&lt;b style=&quot;color: #23a55a; font-size: 13px;&quot;&gt;6. KẾT QUẢ CUỐI CÙNG (OUTCOME)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 16px; color: #ffffff;&quot;&gt;Xử lý triệt để thắc mắc&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align: left; font-size: 12px; color: #dbdee1; line-height: 1.5;&quot;&gt;✓ &lt;b style=&quot;color: #23a55a;&quot;&gt;0 câu hỏi bị bỏ sót&lt;/b&gt; cuối ngày&lt;br&gt;✓ &lt;b style=&quot;color: #23a55a;&quot;&gt;Giảm 80% thời gian rà soát&lt;/b&gt; (từ 25 phút xuống &lt; 5 phút)&lt;br&gt;✓ Học viên nhận phản hồi chuẩn xác, an tâm học tập&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#111214;strokeColor=#23a55a;strokeWidth=2.5;fontColor=#ffffff;align=center;arcSize=8;" vertex="1" parent="1">
