        <!-- Title Banner -->
        <mxCell id="title" value="&lt;b style=&quot;font-size: 20px;&quot;&gt;SƠ ĐỒ LUỒNG TRẢI NGHIỆM NGƯỜI DÙNG (UX FLOW) — CP2 PROTOTYPE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 13px; color: #dbdee1;&quot;&gt;Hệ thống Triage Hỗ trợ TA/Mod rà soát câu hỏi Discord K4 cuối ngày · Mức: Conditional Automation (Nhóm Buddy - E402)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1e1f22;strokeColor=#5865f2;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="1400" height="70" as="geometry" />
        </mxCell>

        <!-- STEP 1: Input -->
        <mxCell id="step1" value="&lt;b style=&quot;color: #5865f2; font-size: 12px;&quot;&gt;1. ĐẦU VÀO (INPUT)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;Tin nhắn Discord K4&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #949ba4;&quot;&gt;Thu thập từ channel_02, 10, 11&lt;br&gt;Câu hỏi thắc mắc, hỏi bài, hỏi quy chế&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b2d31;strokeColor=#3f4147;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="120" width="220" height="90" as="geometry" />
        </mxCell>

        <!-- STEP 2: Preprocessing -->
        <mxCell id="step2" value="&lt;b style=&quot;color: #5865f2; font-size: 12px;&quot;&gt;2. TIỀN XỬ LÝ (PREPROCESS)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;Gom nhóm &amp; Rút thread&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #949ba4;&quot;&gt;Trích xuất câu hỏi ứng viên + Ngữ cảnh hội thoại&lt;br&gt;Loại trừ tin chào hỏi / Bot auto reply&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b2d31;strokeColor=#3f4147;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="240" height="90" as="geometry" />
        </mxCell>

        <!-- STEP 3: KB Retrieval -->
        <mxCell id="step3" value="&lt;b style=&quot;color: #5865f2; font-size: 12px;&quot;&gt;3. TRUY XUẤT CĂN CỨ&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 14px;&quot;&gt;So khớp Knowledge Base&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 11px; color: #949ba4;&quot;&gt;Tra cứu FAQ quy chế chính thức&lt;br&gt;(Điểm danh, Ghép đội, Link Zoom, Deadline)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2b2d31;strokeColor=#3f4147;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=10;" vertex="1" parent="1">
          <mxGeometry x="610" y="120" width="230" height="90" as="geometry" />
