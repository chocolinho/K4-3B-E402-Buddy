        <!-- STEP 4: AI Decision Node -->
        <mxCell id="step4" value="&lt;b style=&quot;color: #ffffff; font-size: 13px;&quot;&gt;4. ĐIỂM QUYẾT ĐỊNH AI (TRIAGE)&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;font-size: 16px; color: #ffffff;&quot;&gt;Đánh giá 3 Trạng thái&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size: 12px; color: #e0e3ff;&quot;&gt;Phân tích mức độ đầy đủ của bằng chứng&lt;/span&gt;&lt;br&gt;&lt;b style=&quot;font-size: 11px; color: #ffd700;&quot;&gt;[Áp HAX G10: Thu hẹp phạm vi khi nghi ngờ]&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5865f2;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;align=center;arcSize=12;" vertex="1" parent="1">
